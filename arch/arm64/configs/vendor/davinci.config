# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_DAVINCI=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# SKU
CONFIG_CMDLINE_HWC_IS_PRODUCT_SKU=y

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# --- BPF LSM + BTF (resolve_btfids now built, see tools/bpf/resolve_btfids) ---
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_LSM=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf"
# CONFIG_SECURITY_SELINUX_DISABLE is not set

# sockmap is a broken half-merge in this tree; Android does not use it.
# CONFIG_BPF_STREAM_PARSER is not set
# CONFIG_BPF_PRELOAD is not set
